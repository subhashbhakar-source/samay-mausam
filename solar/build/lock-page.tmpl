<!doctype html>
<html lang="hi-Latn">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<meta name="referrer" content="no-referrer">
<title>Solar Plant Calculator</title>
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Solar Calc">
<link rel="apple-touch-icon" href="icon-180.png">
<link rel="icon" type="image/png" href="icon-180.png">
<style>
:root {
  --bg: #f1f4f6; --surface: #ffffff; --ink: #0f1d28; --ink-2: #41546a; --ink-3: #5c6e7f;
  --line: #d4dbe2; --line-strong: #aeb9c4; --accent: #1c5cab; --accent-ink: #ffffff; --bad: #b42323;
  color-scheme: light;
  padding: env(safe-area-inset-top, 0px) 0 env(safe-area-inset-bottom, 0px);
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0d1317; --surface: #151c22; --ink: #e8edf1; --ink-2: #b4c0ca; --ink-3: #8a9aa8;
    --line: #27323b; --line-strong: #40505c; --accent: #6aa9ee; --accent-ink: #0b1620; --bad: #f29090;
    color-scheme: dark;
  }
}
*, *::before, *::after { box-sizing: border-box; }
[hidden] { display: none !important; }
body { margin: 0; background: var(--bg); color: var(--ink); font: 16px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
.wrap {
  max-width: 560px; margin: 0 auto;
  padding: 28px max(16px, env(safe-area-inset-right, 0px)) 40px max(16px, env(safe-area-inset-left, 0px));
  display: flex; flex-direction: column; gap: 18px;
}
h1 { font-size: 24px; line-height: 1.2; margin: 0; letter-spacing: -0.01em; }
h2 { font-size: 18px; margin: 0; }
p { margin: 0; }
section { display: flex; flex-direction: column; gap: 16px; }
.card { background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 16px; display: flex; flex-direction: column; gap: 12px; }
.step { font-weight: 600; }
.row { display: flex; flex-wrap: wrap; gap: 8px; }
button { font: inherit; min-height: 44px; padding: 8px 16px; border-radius: 6px; border: 1px solid var(--line-strong); background: var(--surface); color: var(--ink); cursor: pointer; }
button.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); font-weight: 600; }
button.link { border: 0; background: none; padding: 8px 0; color: var(--accent); text-decoration: underline; min-height: 0; align-self: flex-start; }
button:disabled { opacity: 0.6; cursor: default; }
textarea, input[type="text"] {
  font: 14px/1.4 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; width: 100%; padding: 10px;
  border-radius: 6px; border: 1px solid var(--line-strong); background: var(--surface); color: var(--ink); resize: vertical;
}
input[type="text"] { font-size: 17px; letter-spacing: 0.06em; min-height: 46px; resize: none; }
textarea[readonly] { color: var(--ink-2); background: var(--bg); }
label { font-size: 14px; color: var(--ink-2); }
form { display: flex; flex-direction: column; gap: 10px; }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.msg { color: var(--bad); font-weight: 600; }
.msg:empty { display: none; }
.note { font-size: 14px; color: var(--ink-3); }
.note:empty { display: none; }
details { border-top: 1px solid var(--line); padding-top: 12px; }
summary { cursor: pointer; color: var(--ink-2); font-size: 15px; padding: 6px 0; }
details[open] summary { margin-bottom: 10px; }
#g-home, #g-act { display: flex; flex-direction: column; gap: 16px; }
/* the Home Screen steps: a number, then icons, words and arrows on one line */
.how { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; counter-reset: how; }
.how > li { counter-increment: how; display: grid; grid-template-columns: 22px minmax(0, 1fr); column-gap: 8px; row-gap: 4px; align-items: center; }
.how > li::before { content: counter(how) "."; font-weight: 600; color: var(--ink-2); }
.how .line { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-weight: 600; }
.how .note { grid-column: 2; }
.ic { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 38px; border-radius: 10px; border: 1px solid var(--line); background: var(--bg); color: var(--accent); }
.ic svg { width: 22px; height: 22px; display: block; }
.ic.app { border: 0; background: none; }
.ic.app img { width: 38px; height: 38px; border-radius: 9px; display: block; }
.arrow { color: var(--ink-3); font-weight: 400; }
</style>
</head>
<body>
<main class="wrap" id="wrap" hidden>
  <h1>Solar Plant Calculator</h1>

  <p id="v-busy" hidden>Khul raha hai&hellip;</p>

  <p id="v-old" class="msg" hidden></p>

  <section id="v-gate" hidden>
    <p id="g-msg" class="msg" role="alert"></p>
    <p id="g-preview" class="note" hidden>Preview: naye iPhone par link kholne wale ko yeh dikhega.</p>

    <!-- shown in an iPhone browser only: put the page on the Home Screen first, then activate inside the icon.
         The words in Latin letters are the ones the phone and this page show on their buttons. -->
    <div id="g-home" lang="hi" hidden>
      <div class="card">
        <p class="step">इस पेज को होम स्क्रीन पर लगाएँ</p>
        <p class="note" id="g-safari" hidden>पहले यह पेज <span lang="en">Safari</span> में खोलें।</p>
        <ol class="how">
          <li>
            <div class="line">
              <span class="ic" id="g-menu" role="img" aria-label="तीन बिंदु वाला बटन"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5.5" cy="12" r="1.9"/><circle cx="12" cy="12" r="1.9"/><circle cx="18.5" cy="12" r="1.9"/></svg></span>
              <span class="arrow" id="g-menu-arrow" aria-hidden="true">&rarr;</span>
              <span class="ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15V3.5M8.2 7.2 12 3.4l3.8 3.8"/><path d="M8.5 10.5H7a2 2 0 0 0-2 2V19a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6.5a2 2 0 0 0-2-2h-1.5"/></svg></span>
              <span><span lang="en">Share</span> दबाएँ</span>
            </div>
            <p class="note" id="g-menu-note">&#8943; न दिखे तो सीधे <span lang="en">Share</span> दबाएँ।</p>
          </li>
          <li>
            <div class="line">
              <span class="ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="4.5"/><path d="M12 8.2v7.6M8.2 12h7.6"/></svg></span>
              <span lang="en">Add to Home Screen</span>
              <span class="arrow" aria-hidden="true">&rarr;</span>
              <span lang="en">Add</span>
            </div>
            <p class="note">यह सूची में नीचे मिलेगा।</p>
          </li>
          <li>
            <div class="line">
              <span class="ic app" aria-hidden="true"><img src="icon-180.png" alt="" width="38" height="38"></span>
              <span>नया आइकन खोलें</span>
              <span class="arrow" aria-hidden="true">&rarr;</span>
              <span><span lang="en">Activate</span> करें</span>
            </div>
          </li>
        </ol>
      </div>
    </div>
    <button type="button" class="link" id="g-skip" lang="hi" hidden>होम स्क्रीन के बिना खोलें</button>

    <div id="g-act">
      <h2>Activate karein</h2>
      <div class="card">
        <p class="step">1. Jisne link diya, unhe request bhejein</p>
        <div class="row">
          <button type="button" class="primary" id="g-send">Request bhejein</button>
          <button type="button" id="g-copy">Copy</button>
        </div>
        <p class="note" id="g-copied" role="status"></p>
        <textarea id="g-req" rows="4" readonly hidden aria-label="Request"></textarea>
      </div>

      <div class="card">
        <p class="step" id="g-step2">2. Key ka link dabayein, ya yahan paste karein</p>
        <form id="g-form">
          <textarea id="g-key" rows="3" aria-label="Key" autocomplete="off" autocapitalize="off" spellcheck="false"></textarea>
          <div class="row">
            <button type="button" id="g-paste" hidden>Paste</button>
            <button type="submit" class="primary">Kholein</button>
          </div>
        </form>
      </div>
    </div>

    <details id="g-owner">
      <summary>Main owner hoon</summary>
      <form id="o-form">
        <input type="text" id="o-key" aria-label="Owner key" placeholder="Owner key" autocomplete="off" autocapitalize="characters" autocorrect="off" spellcheck="false">
        <button type="submit" class="primary">Kholein</button>
      </form>
      <p id="o-msg" class="msg" role="alert"></p>
    </details>
  </section>

  <section id="v-approve" hidden>
    <h2>Key banayein</h2>
    <div class="card" id="a-in">
      <p class="step">1. Request yahan paste karein</p>
      <form id="a-form">
        <textarea id="a-code" rows="3" aria-label="Request" autocomplete="off" autocapitalize="off" spellcheck="false"></textarea>
        <div class="row">
          <button type="button" id="a-paste" hidden>Paste</button>
          <button type="submit" class="primary">Key banayein</button>
        </div>
      </form>
    </div>
    <p id="a-msg" class="msg" role="alert"></p>
    <div class="card" id="a-out" hidden>
      <p class="step" id="a-step">2. Key wapas bhejein</p>
      <div class="row">
        <button type="button" class="primary" id="a-send">Key bhejein</button>
        <button type="button" id="a-copy">Copy</button>
      </div>
      <p class="note" id="a-copied" role="status"></p>
      <textarea id="a-key" rows="5" readonly hidden aria-label="Key"></textarea>
    </div>
    <button type="button" class="link" id="a-back">Calculator kholein</button>
  </section>
</main>
