 * in the Software without restriction, including without limitation the rights
 * to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
 * copies of the Software, and to permit persons to whom the Software is
 * furnished to do so, subject to the following conditions:
 *
 * The above copyright notice and this permission notice shall be included in all
 * copies or substantial portions of the Software.
 *
 * THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
 * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
 * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
 * AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
 * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
 * OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
 * SOFTWARE.
 */
(function () {
  'use strict';
  var P = __PAYLOAD__;
  var inflate = (function () {
__INFLATE__
    return tinf_uncompress;
  })();

  var DEV = 'solar-calc.device', DKEY = 'solar-calc.key', OWN = 'solar-calc.owner';
  var INFO = 'solar-calc/device-key/v1';
  var EC = { name: 'ECDH', namedCurve: 'P-256' };
  var subtle = window.crypto && window.crypto.subtle;
  var HERE = location.origin + location.pathname;
  var contentKey = null;                       /* held only while the approve screen is open */
  function $(id) { return document.getElementById(id); }

  var TEXT = {
    notKey: 'Yeh key sahi nahin hai. Poora message paste karein.',
    otherDevice: 'Yeh key is device ke liye nahin hai. Nayi request bhejein.',
    stale: 'Key ab kaam nahin karti. Nayi request bhejein.',
    ownerWrong: 'Owner key galat hai.',
    ownerNeeded: 'Pehle owner key daalein.',
    notRequest: 'Yeh request sahi nahin hai. Poora message paste karein.',
    noStore: 'Private window mein nahin khulega. Normal window mein kholein.',
    unsupported: 'Yeh browser purana hai. Naya Chrome ya Safari istemal karein.',
    copied: 'Copy ho gaya.',
    copyFail: 'Copy nahin hua. Neeche ka text copy karein.'
  };
  function say(el, key) { el.textContent = key ? TEXT[key] : ''; }
  function view(name) {
    ['busy', 'old', 'gate', 'approve'].forEach(function (v) { $('v-' + v).hidden = v !== name; });
    $('wrap').hidden = false;
  }

  /* storage that never throws */
  function get(k) { try { return window.localStorage.getItem(k); } catch (e) { return null; } }
  function put(k, v) { try { window.localStorage.setItem(k, v); return window.localStorage.getItem(k) === v; } catch (e) { return false; } }
  function drop(k) { try { window.localStorage.removeItem(k); } catch (e) {} }

  /* bytes */
  function bytes(s) {
    s = s.replace(/-/g, '+').replace(/_/g, '/');
    while (s.length % 4) s += '=';
    var bin = atob(s), a = new Uint8Array(bin.length), i;
    for (i = 0; i < bin.length; i++) a[i] = bin.charCodeAt(i);
    return a;
  }
  function text64(a) {
    var s = '', i;
    for (i = 0; i < a.length; i++) s += String.fromCharCode(a[i]);
    return btoa(s).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
  }
  function utf8(s) { return new TextEncoder().encode(s); }
  function join() {
    var n = 0, o = 0, i, out;
    for (i = 0; i < arguments.length; i++) n += arguments[i].length;
    out = new Uint8Array(n);
    for (i = 0; i < arguments.length; i++) { out.set(arguments[i], o); o += arguments[i].length; }
    return out;
  }

  /* AES-GCM with a raw 32-byte key */
  function unseal(raw, iv, data) {
    return subtle.importKey('raw', raw, { name: 'AES-GCM' }, false, ['decrypt'])
      .then(function (k) { return subtle.decrypt({ name: 'AES-GCM', iv: iv }, k, data); })
      .then(function (b) { return new Uint8Array(b); });
  }
  function seal(raw, iv, data) {
    return subtle.importKey('raw', raw, { name: 'AES-GCM' }, false, ['encrypt'])
      .then(function (k) { return subtle.encrypt({ name: 'AES-GCM', iv: iv }, k, data); })
      .then(function (b) { return new Uint8Array(b); });
  }

  /* owner key -> content key */
  function ownerBytes(typed) {
    var clean = String(typed).toUpperCase().replace(/[^A-Z0-9]/g, '');
    return subtle.importKey('raw', utf8(clean), 'PBKDF2', false, ['deriveBits'])
      .then(function (k) { return subtle.deriveBits({ name: 'PBKDF2', hash: 'SHA-256', salt: bytes(P.os), iterations: P.oi }, k, 256); })
      .then(function (b) { return new Uint8Array(b); });
  }
  function keyFromOwner(ob) { return unseal(ob, bytes(P.ov), bytes(P.ow)); }

  /* this device's own key pair; the private half never leaves this browser */
  function device(create) {
    var saved = get(DEV), o = null;
    if (saved) { try { o = JSON.parse(saved); } catch (e) { o = null; } }
    if (o && o.j && o.p) {
      return subtle.importKey('jwk', o.j, EC, false, ['deriveBits']).then(function (priv) { return { priv: priv, pub: bytes(o.p) }; });
    }
    if (!create) return Promise.resolve(null);
    return subtle.generateKey(EC, true, ['deriveBits']).then(function (pair) {
      return Promise.all([subtle.exportKey('jwk', pair.privateKey), subtle.exportKey('raw', pair.publicKey)]).then(function (r) {
        var pub = new Uint8Array(r[1]);
        if (!put(DEV, JSON.stringify({ j: r[0], p: text64(pub) }))) throw new Error('nostore');
        return { priv: pair.privateKey, pub: pub };
      });
    });
  }
  /* the secret two key pairs share, tied to both public halves */
  function sharedKey(priv, otherPub, ephPub, devPub) {
    return subtle.importKey('raw', otherPub, EC, false, [])
      .then(function (pub) { return subtle.deriveBits({ name: 'ECDH', public: pub }, priv, 256); })
      .then(function (bits) { return subtle.digest('SHA-256', join(new Uint8Array(bits), ephPub, devPub, utf8(INFO))); })
      .then(function (h) { return new Uint8Array(h); });
  }
  /* owner: seal the content key for one device */
  function makeDeviceKey(K, devPub) {
    return subtle.generateKey(EC, true, ['deriveBits']).then(function (eph) {
      return subtle.exportKey('raw', eph.publicKey).then(function (er) {
        var ephPub = new Uint8Array(er), iv = window.crypto.getRandomValues(new Uint8Array(12));
        return sharedKey(eph.privateKey, devPub, ephPub, devPub)
          .then(function (kek) { return seal(kek, iv, K); })
          .then(function (ct) { return 'K1.' + text64(join(ephPub, iv, ct)); });
      });
    });
  }
  /* a device: open a sealed key with its own private half */
  function keyFromDeviceKey(str) {
    var m = /K1\.([A-Za-z0-9_-]{120,})/.exec(String(str || '')), rawKey;
    if (!m) return Promise.reject(new Error('format'));
    try { rawKey = bytes(m[1]); } catch (e) { return Promise.reject(new Error('format')); }
    if (rawKey.length !== 125) return Promise.reject(new Error('format'));
    return device(false).then(function (d) {
      if (!d) throw new Error('other');
      var ephPub = rawKey.slice(0, 65), iv = rawKey.slice(65, 77), ct = rawKey.slice(77);
      return sharedKey(d.priv, ephPub, ephPub, d.pub).then(function (kek) { return unseal(kek, iv, ct); })
        .then(function (K) { return { K: K, text: 'K1.' + m[1] }; }, function () { throw new Error('other'); });
    });
  }

  /* content key -> the page */
  function pageFrom(K) {
    return unseal(K, bytes(P.iv), bytes(P.ct)).then(function (zipped) {
      return new TextDecoder('utf-8').decode(inflate(zipped, new Uint8Array(P.n)));
    });
  }
  function tidyAddress() { try { window.history.replaceState(null, '', location.pathname + location.search); } catch (e) {} }
  function showPage(K) {
    return pageFrom(K).then(function (html) {
      tidyAddress();
      document.open();
      document.write(html);
      document.close();
    });
  }

  /* sending and copying */
  function send(text) {
    if (navigator.share) { navigator.share({ text: text }).catch(function () {}); return; }
    window.open('https://wa.me/?text=' + encodeURIComponent(text), '_blank', 'noopener');
  }
  /* the text sits in a hidden box; the box is shown only when copying fails, so it can be copied by hand */
  function copy(area, note) {
    function done(ok) { area.hidden = ok; say(note, ok ? 'copied' : 'copyFail'); }
    function byHand() {
      var ok = false;
      area.hidden = false;
      try { area.focus(); area.select(); ok = document.execCommand('copy'); } catch (e) {}
      done(ok);
    }
    if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(area.value).then(function () { done(true); }, byHand);
    else byHand();
  }

  /* ---- the lock screen ---- */
  function gate(message, ownerOpen) {
    view('gate');
    say($('g-msg'), message || null);
    if (ownerOpen) $('g-owner').open = true;
    device(true).then(function (d) {
      $('g-req').value = 'Solar Plant Calculator: mera device approve karein\n' + HERE + '#approve=D1.' + text64(d.pub);
    }, function () { say($('g-msg'), 'noStore'); $('g-send').disabled = true; $('g-copy').disabled = true; });
  }
  function tryDeviceKey(str, onFail) {
    return keyFromDeviceKey(str).then(function (r) {
      put(DKEY, r.text);
      return showPage(r.K);
    }).catch(function (e) { onFail(e && e.message === 'format' ? 'notKey' : 'otherDevice'); });
  }

  /* ---- the owner's approve screen ---- */
  function approve(K, request) {
    contentKey = K;
    view('approve');
    $('a-out').hidden = true;
    say($('a-msg'), null);
    /* a request that came as a link needs no pasting: the key is made at once */
    $('a-in').hidden = !!request;
    $('a-step').textContent = request ? 'Key taiyaar hai. Wapas bhejein.' : '2. Key wapas bhejein';
    if (request) { $('a-code').value = request; makeFromRequest(); }
  }
  function makeFromRequest() {
    var m = /D1\.([A-Za-z0-9_-]{80,})/.exec($('a-code').value), devPub;
    $('a-out').hidden = true;
    say($('a-copied'), null);
    try { devPub = m ? bytes(m[1]) : null; } catch (e) { devPub = null; }
    if (!devPub || devPub.length !== 65) { $('a-in').hidden = false; say($('a-msg'), 'notRequest'); return; }
    makeDeviceKey(contentKey, devPub).then(function (k) {
      say($('a-msg'), null);
      $('a-key').value = 'Solar Plant Calculator: aapki key\n' + HERE + '#key=' + k;
      $('a-out').hidden = false;
    }, function () { $('a-in').hidden = false; say($('a-msg'), 'notRequest'); });
  }

  /* ---- start ---- */
  function hashValue(name) {
    var m = new RegExp('[#&]' + name + '=([^&]*)').exec(location.hash || '');
    if (!m) return null;
    try { return decodeURIComponent(m[1]); } catch (e) { return m[1]; }
  }
  function start() {
    var wantsApprove = /^#approve/.test(location.hash || ''), request = hashValue('approve');
    var linkKey = hashValue('key'), owner = get(OWN), saved = get(DKEY);

    if (owner) {
      view('busy');
      keyFromOwner(bytes(owner)).then(function (K) {
        if (wantsApprove) { approve(K, request ? 'D1.' + request.replace(/^D1\./, '') : null); return null; }
        return showPage(K);
      }).catch(function () { drop(OWN); start(); });
      return;
    }
    if (wantsApprove) { gate('ownerNeeded', true); return; }
    if (linkKey) {
      view('busy');
      tryDeviceKey(linkKey, function (why) {
        if (saved && saved !== linkKey) tryDeviceKey(saved, function () { drop(DKEY); gate(why); });
        else gate(why);
      });
      return;
    }
    if (saved) {
      view('busy');
      tryDeviceKey(saved, function () { drop(DKEY); gate('stale'); });
      return;
    }
    gate(null);
  }

  $('g-send').addEventListener('click', function () { send($('g-req').value); });
  $('g-copy').addEventListener('click', function () { copy($('g-req'), $('g-copied')); });
  $('g-form').addEventListener('submit', function (e) {
    e.preventDefault();
    say($('g-msg'), null);
    tryDeviceKey($('g-key').value, function (why) { say($('g-msg'), why); $('g-msg').scrollIntoView({ block: 'center' }); });
  });
  $('o-form').addEventListener('submit', function (e) {
    var btn = e.target.querySelector('button');
    e.preventDefault();
    say($('o-msg'), null);
    btn.disabled = true;
    ownerBytes($('o-key').value).then(function (ob) {
      return keyFromOwner(ob).then(function (K) {
        put(OWN, text64(ob));
        if (/^#approve/.test(location.hash || '')) { var r = hashValue('approve'); approve(K, r ? 'D1.' + r.replace(/^D1\./, '') : null); return null; }
        return showPage(K);
      });
    }).catch(function () { btn.disabled = false; say($('o-msg'), 'ownerWrong'); });
  });
  $('a-form').addEventListener('submit', function (e) { e.preventDefault(); makeFromRequest(); });
  $('a-send').addEventListener('click', function () { send($('a-key').value); });
  $('a-copy').addEventListener('click', function () { copy($('a-key'), $('a-copied')); });
  $('a-back').addEventListener('click', function () { if (contentKey) showPage(contentKey); });
  window.addEventListener('hashchange', function () { location.reload(); });

  if (!subtle || !window.TextDecoder || !window.TextEncoder || !window.Promise) { view('old'); say($('v-old'), 'unsupported'); }
  else start();
})();
</script>
</body>
</html>
