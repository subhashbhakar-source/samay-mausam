<!doctype html>
<html lang="hi-Latn">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<meta name="referrer" content="no-referrer">
<title>Solar Plant Calculator</title>
<style>
:root {
  --bg: #f1f4f6; --surface: #ffffff; --ink: #0f1d28; --ink-2: #41546a; --ink-3: #5c6e7f;
  --line: #d4dbe2; --line-strong: #aeb9c4; --accent: #1c5cab; --accent-ink: #ffffff; --bad: #b42323;
  color-scheme: light;
  padding: env(safe-area-inset-top, 0px) 0 env(safe-area-inset-bottom, 0px);
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0d1317; --surface: #151c22; --ink: #e8edf1; --ink-2: #b4c0ca; --ink-3: #8a9aa8;
    --line: #27323b; --line-strong: #40505c; --accent: #6aa9ee; --accent-ink: #0b1620; --bad: #f29090;
    color-scheme: dark;
  }
}
*, *::before, *::after { box-sizing: border-box; }
[hidden] { display: none !important; }
body { margin: 0; background: var(--bg); color: var(--ink); font: 16px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
.wrap {
  max-width: 560px; margin: 0 auto;
  padding: 28px max(16px, env(safe-area-inset-right, 0px)) 40px max(16px, env(safe-area-inset-left, 0px));
  display: flex; flex-direction: column; gap: 18px;
}
h1 { font-size: 24px; line-height: 1.2; margin: 0; letter-spacing: -0.01em; }
h2 { font-size: 18px; margin: 0; }
p { margin: 0; }
section { display: flex; flex-direction: column; gap: 16px; }
.card { background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 16px; display: flex; flex-direction: column; gap: 12px; }
.step { font-weight: 600; }
.row { display: flex; flex-wrap: wrap; gap: 8px; }
button { font: inherit; min-height: 44px; padding: 8px 16px; border-radius: 6px; border: 1px solid var(--line-strong); background: var(--surface); color: var(--ink); cursor: pointer; }
button.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); font-weight: 600; }
button.link { border: 0; background: none; padding: 8px 0; color: var(--accent); text-decoration: underline; min-height: 0; align-self: flex-start; }
button:disabled { opacity: 0.6; cursor: default; }
textarea, input[type="text"] {
  font: 14px/1.4 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; width: 100%; padding: 10px;
  border-radius: 6px; border: 1px solid var(--line-strong); background: var(--surface); color: var(--ink); resize: vertical;
}
input[type="text"] { font-size: 17px; letter-spacing: 0.06em; min-height: 46px; resize: none; }
textarea[readonly] { color: var(--ink-2); background: var(--bg); }
label { font-size: 14px; color: var(--ink-2); }
form { display: flex; flex-direction: column; gap: 10px; }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.msg { color: var(--bad); font-weight: 600; }
.msg:empty { display: none; }
.note { font-size: 14px; color: var(--ink-3); }
.note:empty { display: none; }
details { border-top: 1px solid var(--line); padding-top: 12px; }
summary { cursor: pointer; color: var(--ink-2); font-size: 15px; padding: 6px 0; }
details[open] summary { margin-bottom: 10px; }
</style>
</head>
<body>
<main class="wrap" id="wrap" hidden>
  <h1>Solar Plant Calculator</h1>

  <p id="v-busy" hidden>Khul raha hai&hellip;</p>

  <p id="v-old" class="msg" hidden></p>

  <section id="v-gate" hidden>
    <p id="g-msg" class="msg" role="alert"></p>

    <div class="card">
      <p class="step">1. Jisne link diya, unhe request bhejein</p>
      <div class="row">
        <button type="button" class="primary" id="g-send">Request bhejein</button>
        <button type="button" id="g-copy">Copy</button>
      </div>
      <p class="note" id="g-copied" role="status"></p>
      <textarea id="g-req" rows="4" readonly hidden aria-label="Request"></textarea>
    </div>

    <div class="card">
      <p class="step">2. Key ka link dabayein, ya yahan paste karein</p>
      <form id="g-form">
        <textarea id="g-key" rows="3" aria-label="Key" autocomplete="off" autocapitalize="off" spellcheck="false"></textarea>
        <button type="submit" class="primary">Kholein</button>
      </form>
    </div>

    <details id="g-owner">
      <summary>Main owner hoon</summary>
      <form id="o-form">
        <input type="text" id="o-key" aria-label="Owner key" placeholder="Owner key" autocomplete="off" autocapitalize="characters" autocorrect="off" spellcheck="false">
        <button type="submit" class="primary">Kholein</button>
      </form>
      <p id="o-msg" class="msg" role="alert"></p>
    </details>
  </section>

  <section id="v-approve" hidden>
    <h2>Key banayein</h2>
    <div class="card" id="a-in">
      <p class="step">1. Request yahan paste karein</p>
      <form id="a-form">
        <textarea id="a-code" rows="3" aria-label="Request" autocomplete="off" autocapitalize="off" spellcheck="false"></textarea>
        <button type="submit" class="primary">Key banayein</button>
      </form>
    </div>
    <p id="a-msg" class="msg" role="alert"></p>
    <div class="card" id="a-out" hidden>
      <p class="step" id="a-step">2. Key wapas bhejein</p>
      <div class="row">
        <button type="button" class="primary" id="a-send">Key bhejein</button>
        <button type="button" id="a-copy">Copy</button>
      </div>
      <p class="note" id="a-copied" role="status"></p>
      <textarea id="a-key" rows="5" readonly hidden aria-label="Key"></textarea>
    </div>
    <button type="button" class="link" id="a-back">Calculator kholein</button>
  </section>
</main>
<script>
/*
 * Lock for a page kept encrypted in this file. See README.md in this folder.
 * The unzip code is tiny-inflate 1.0.3 (https://github.com/foliojs/tiny-inflate), under this licence:
