  var PREVIEW = !APP && /[?&]preview(?:[=&]|$)/.test(location.search || '');
  var KEY_LINK = '\uD83D\uDD11 Solar Plant Calculator ki key\n\uD83D\uDC47 Yeh link dabayein\n';
  var KEY_APP = '\uD83D\uDD11 Solar Plant Calculator ki key\n' +
